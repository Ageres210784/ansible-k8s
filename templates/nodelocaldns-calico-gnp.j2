apiVersion: crd.projectcalico.org/v1
kind: Tier
metadata:
  name: pre-calico
spec:
  order: 80
  defaultAction: Pass
---
apiVersion: crd.projectcalico.org/v1
kind: GlobalNetworkPolicy
metadata:
  name: pre-calico.nodelocaldns
spec:
  tier: pre-calico
  order: 100
  namespaceSelector: projectcalico.org/name in {"calico-system", "tigera-operator"}
  types:
  - Egress
  egress:
  - action: Allow
    protocol: UDP
    destination:
      nets:
      - {{ k8s_nodelocaldns_local_ip }}/32
      ports:
      - 53
  - action: Allow
    protocol: TCP
    destination:
      nets:
      - {{ k8s_nodelocaldns_local_ip }}/32
      ports:
      - 53
  - action: Pass
